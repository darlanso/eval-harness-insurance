# Dataset
DATASET_PATH=data/AutoInsuranceClaims2024.csv

# AI provider: anthropic | openai
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Actuarial rules
SEVERITY_CAP=2000
HIGH_RISK_MIN_COMPLAINTS=3
HIGH_RISK_CLAIM_PREMIUM_RATIO=10
SCORE_TOLERANCE=15

# Run control
ACCURACY_THRESHOLD=1.0
MAX_CASES=
CONCURRENCY=1
AI_TIMEOUT_MS=30000
# Optional. Leave empty for current Claude models, which reject sampling parameters.
AI_TEMPERATURE=
